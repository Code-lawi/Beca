# ============================================
# SCI-CALC Environment Configuration (Example)
# ============================================
# Copy this file to .env and update values

# ===== DATABASE SETTINGS =====
DB_HOST=localhost
DB_USER=root
DB_PASS=your_password_here
DB_NAME=sci_calc

# ===== APPLICATION SETTINGS =====
APP_NAME=SCI-CALC
APP_ENV=production
APP_DEBUG=false
APP_URL=http://yourdomain.com/

# ===== CONTACT SETTINGS =====
WHATSAPP_NUMBER=your_whatsapp_number
INSTAGRAM_LINK=https://instagram.com/your_username

# ===== TIMEZONE =====
TIMEZONE=Africa/Dar_es_Salaam